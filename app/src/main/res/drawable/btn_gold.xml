<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <gradient
                android:angle="270"
                android:endColor="#D98E00"
                android:startColor="#F2B733" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <solid android:color="#66F5B301" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <gradient
                android:angle="270"
                android:endColor="#E89900"
                android:startColor="#FFD254" />
        </shape>
    </item>
</selector>
