                "is_last": true
            },
            {
                "id": 2,
                "title": "Marianna",
                "description": "Wow, already at the maximum number of chips?! Nicely done! By the way, they reset the counter every day — just come back again tomorrow.\n\n<font color='#ffff00'>Chips earned in the casino today: %s.\nThe limit resets daily at 5:00 MSK.\nFor detailed information, see the Rules",
                "speaker": {"type": "npc", "skin": 5500138},
