        "noCollision" : {"isEnabled": false, "radius": 30},
        "dialog"      : [
            {
                "id": 1,
                "title": "Доминик",
                "description": "Йоу, это твоя тачка у входа? Тут намечается гонка для избранных. Элита, все дела. Записывайся, не пожалеешь — только самые высокие ставки, играем по-крупному!",
