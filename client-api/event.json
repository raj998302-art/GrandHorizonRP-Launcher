    "npcMinigame1"   : {
        "isEnabled"   : true,
        "id"          : 5500053,
        "type"        : "npc",
        "coords"      : [-58.92, 830.81, 15.19, 39.0],
        "name"        : "Мини-игра - {FFFF00}Великое ограбление\n{FFFFFF}Подойдите для {FFFF00}взаимодействия",
        "useNameCords": "false",
        "cameraPos"   : {
            "StartPos"   : [-57.46, 834.66, 16.0 ],
            "StartLookAt": [-59.44, 831.4 , 15.19]
        },
        "noCollision" : {"isEnabled": false, "radius": 30},
        "dialog"      : [
            {
                "id": 1,
                "title": "Лев",
                "description": "Эй, говорят, ты человек надежный и неболтливый?.. А мы тут с ребятами как раз планируем кое-что грандиозное. Для нового казино уже приготовлены большие деньги, и мы знаем, где они хранятся. Смекаешь? Вот только система защиты у них мудреная, да и не только нас этот куш интересует… Если поможешь — доля твоя!",
                "speaker": {"type": "npc", "skin": 5500053},
                "sound": "Event/lev_info-001.ogg",
                "buttons": [
                    {"name": "Начать игру", "color": "green"},
                    {"name": "Правила",     "color": "grey" },
                    {"name": "Закрыть",     "color": "red"  }
                ],
                "is_last": true
            }
        ]
    },
    "npcMinigame2"   : {
        "isEnabled"   : true,
        "id"          : 5500102,
        "type"        : "npc",
        "coords"      : [-104.1, 849.89, 15.19, 235.0],
        "name"        : "Мини-игра - {FFFF00}Гонка Колосс\n{FFFFFF}Подойдите для {FFFF00}взаимодействия",
        "useNameCords": "false",
