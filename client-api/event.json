        "dialog"      : [
            {
                "id": 1,
                "title": "Хайроллерша",
                "description": "Хей! Тебя это точно заинтересует! Мегакрутая вечеринка в Кристалле! Приглашаются только лучшие из лучших. Вот, возьми флаер!<br><br><font color='#ffff00'>Прими участие в событии Большой Куш — собирай Фишки, играй в мини-игры, проходи ленту события. До %s</font>",
                "speaker": {"type": "npc", "skin": 5500141},
                "sound": "Event/pestraya_info-001.ogg",
                "buttons": [
                    {"name": "Отметить на карте", "color": "green"},
                    {"name": "Закрыть",           "color": "red"  }
                ],
                "is_last": true
            }
        ]
