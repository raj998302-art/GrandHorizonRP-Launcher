    "npcCasinoHub"   : {
        "isEnabled"   : true,
        "id"          : 5500138,
        "type"        : "npc",
        "coords"      : [-88.09, 809.56, 15.27, 344.15],
        "name"        : "Мини-игры - {FFFF00}Фишки в казино\n{FFFFFF}Подойдите для {FFFF00}взаимодействия",
        "useNameCords": "false",
        "cameraPos"   : {
            "StartPos"   : [-83.86, 809.83, 16.1 ],
            "StartLookAt": [-87.85, 810.4 , 15.28]
        },
        "noCollision" : {"isEnabled": false, "radius": 30},
        "dialog"      : [
            {
                "id": 1,
                "title": "Марианна",
                "description": "Эй, притормози! У меня есть отличная новость для тебя. Знаешь же старое казино на краю города? Там сейчас раздают Фишки в честь открытия Кристалла! На халяву! Тебе нужно только выиграть в любой активности. Это очень щедро, так что поспеши!\n\n<font color='#ffff00'>Заработано Фишек в казино сегодня: %s.\nЛимит сбрасывается в 5:00 МСК ежедневно.\nДля подробной информации см. Правила",
                "speaker": {"type": "npc", "skin": 5500138},
                "sound": "Event/marianna_info-001.ogg",
                "buttons": [
                    {"name": "Правила",           "color": "grey" },
                    {"name": "Отметить на карте", "color": "green"},
                    {"name": "Закрыть",           "color": "red"  }
                ],
                "is_last": true
            },
            {
                "id": 2,
                "title": "Марианна",
                "description": "Ого, уже максимум фишек?! Красава! Кстати, они обнуляют счетчик каждый день — просто приходи завтра снова.\n\n<font color='#ffff00'>Заработано Фишек в казино сегодня: %s.\nЛимит сбрасывается в 5:00 МСК ежедневно.\nДля подробной информации см. Правила",
                "speaker": {"type": "npc", "skin": 5500138},
                "sound": "Event/marianna_info-002.ogg",
                "buttons": [
                    {"name": "Правила", "color": "grey"},
                    {"name": "Закрыть", "color": "red" }
                ],
                "is_last": true
            }
        ]
    },
