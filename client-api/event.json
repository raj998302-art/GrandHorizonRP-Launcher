        },
        "noCollision" : {"isEnabled": false, "radius": 30},
        "dialog"      : [
            {
                "id": 1,
                "title": "Lev",
                "description": "Hey, they say you're reliable and know how to keep quiet?.. Me and the guys are planning something grand. Big money has already been prepared for the new casino, and we know where it's being kept. You get the idea? The only problem is, their security system is complicated, and we're not the only ones interested in that score... Help us, and your cut is guaranteed!",
                "speaker": {"type": "npc", "skin": 5500053},
                "sound": "Event/lev_info-001.ogg",
                "buttons": [
                    {"name": "Start game", "color": "green"},
                    {"name": "Rules",     "color": "grey" },
                    {"name": "Close",     "color": "red"  }
                ],
                "is_last": true
            }
        ]
    },
