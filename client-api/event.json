        "dialog"      : [
            {
                "id": 1,
                "title": "Marianna",
                "description": "Hey, slow down! I have great news for you. You know that old casino on the edge of town, right? They're giving away Chips there now in honor of the opening of Kristall! For free! You only need to win in any activity. That's very generous, so hurry!\n\n<font color='#ffff00'>Chips earned in the casino today: %s.\nThe limit resets daily at 5:00 MSK.\nFor detailed information, see the Rules",
                "speaker": {"type": "npc", "skin": 5500138},
                "sound": "Event/marianna_info-001.ogg",
                "buttons": [
                    {"name": "Rules",           "color": "grey" },
